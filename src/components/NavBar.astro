---
import { Icon } from "astro-icon/components";

const currentPath = Astro.url.pathname;

const links = [
    { href: "/", text: "Inicio" },
    { href: "/circulares", text: "Circulares" },
    { href: "/procesos-academico", text: "Profesores" },
    { href: "/zona-alterna", text: "Zona Alterna" },
    { href: "#contact", text: "Contactanos" },
];

const isActive = (href: string) => {
    if (href === "/") {
        return currentPath === "/";
    }

    const baseHref = href.replace(/\/\d+$/, "");
    const baseCurrentPath = currentPath.replace(/\/\d+$/, "");
    return baseCurrentPath === baseHref;
};

---

<header class="bg-white shadow-sm">
    <div class="container mx-auto py-3 lg:py-4 px-4">
        <div class="flex items-center justify-between">
            <a href="/" class="flex items-center gap-2">
                <Icon name="logo" size={32} class="inline-block" />
                <span class="font-bold text-lg lg:text-2xl">El Japon</span>
            </a>

            <!-- Desktop nav -->
            <nav class="hidden md:flex items-center gap-x-6">
                {
                    links.map(({ href, text }) => (
                        <div class="flex flex-col items-center">
                            <a href={href} class="text-black capitalize hover:text-[#7BA43E]">
                                {text}
                            </a>
                            {isActive(href) ? (
                                <div class="w-full h-0.5 bg-[#7BA43E] mt-1" />
                            ) : (
                                <div class="w-full h-0.5 bg-transparent mt-1" />
                            )}
                        </div>
                    ))
                }
            </nav>

            <!-- Mobile hamburger -->
            <div class="md:hidden">
                <button id="nav-toggle" aria-label="Abrir menú" aria-expanded="false" class="p-2 rounded-md focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#7BA43E]">
                    <svg id="icon-open" class="h-6 w-6 text-black" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                    </svg>
                    <svg id="icon-close" class="h-6 w-6 text-black hidden" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>
        </div>

        <!-- Mobile menu (hidden by default) -->
        <div id="mobile-menu" class="md:hidden mt-3 hidden">
            <div class="flex flex-col bg-white rounded-lg shadow-md py-2">
                {
                    links.map(({ href, text }) => (
                        <a href={href} class="px-4 py-2 text-black hover:bg-gray-100 capitalize">
                            {text}
                        </a>
                    ))
                }
            </div>
        </div>
    </div>
</header>
