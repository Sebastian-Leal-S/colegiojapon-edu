---
import { ClientRouter } from "astro:transitions";
import { siteInfo } from "@/const/site-info";
import "@/styles/global.css"

interface Props {
	title: string;
	description?: string;
	image?: string;
}

const { title = siteInfo.title, description = siteInfo.description, image } = Astro.props;
---
<!doctype html>
<html lang="es" style="--header-height: 80px;">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		
		<!-- SEO -->
		<meta name="description" content={description}>
		<meta name="author" content={"Sebastian Leal Sanchez"}>

		<!-- OG Metatags -->
		<meta property="og:title" content={title}>
		<meta property="og:description" content={description}>
		<meta property="og:image" content={image}>

		<ClientRouter />

		<title>{ `DEV | ${title}` }</title>
	</head>
	<body class="bg-white text-slate-900 antialiased selection:bg-blue-500 selection:text-white">
		<slot/>

		<script type="module" src="/js/navbar.js" defer></script>
	</body>
</html>
